pipeline {
    agent any

    environment {
        DOCKER_IMAGE      = "chiragg619/nodejs-app"
        DOCKER_TAG        = "build-${BUILD_NUMBER}"
        APP_SERVER_IP     = "54.152.158.73"
        GEMINI_API_KEY    = credentials('gemini-api-key')
        SLACK_WEBHOOK_URL = credentials('slack-webhook')
    }

    stages {

        stage('Git Checkout') {
            steps {
                echo '📥 Checking out code from GitHub...'
                git branch: 'main',
                    credentialsId: 'github-creds',
                    url: 'https://github.com/chiragpuniyanii/smartops.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo '📦 Installing Node.js dependencies...'
                dir('app') {
                    sh 'npm install'
                }
            }
        }

        stage('Run Tests') {
            steps {
                echo '🧪 Running test suite...'
                dir('app') {
                    sh 'npm test || true'
                }
            }
        }

        stage('AI Code Review') {
            steps {
                echo '🤖 Running AI Code Review via Gemini...'
                sh 'python3 ai-engine/code-review.py || true'
            }
        }

        stage('Docker Build') {
            steps {
                echo '🐳 Building Docker image...'
                sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} -f docker/Dockerfile ."
                sh "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"
            }
        }

        stage('AI Risk Score') {
            steps {
                echo '🎯 Calculating AI Deployment Risk Score...'
                sh 'python3 ai-engine/risk-scorer.py || true'
            }
        }

        stage('Docker Push') {
            steps {
                echo '📤 Pushing image to Docker Hub...'
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh "echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin"
                    sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                    sh "docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo '☸️ Deploying to Kubernetes on App Server...'
                sh """
                    ssh -o StrictHostKeyChecking=no ubuntu@${APP_SERVER_IP} \
                    'sudo kubectl set image deployment/smartops-app \
                    smartops-app=${DOCKER_IMAGE}:${DOCKER_TAG} || true'
                """
            }
        }

        stage('Health Check') {
            steps {
                echo '💓 Running health check...'
                sh 'sleep 15'
                sh "curl -f http://${APP_SERVER_IP}:30000/ || exit 1"
            }
        }

    }

    post {
        success {
            echo '✅ Pipeline completed successfully!'
            sh 'python3 ai-engine/incident-report.py success || true'
        }
        failure {
            echo '❌ Pipeline failed — generating AI incident report...'
            sh 'python3 ai-engine/incident-report.py failure || true'
        }
    }
}